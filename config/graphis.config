[TAGS]
# Tag Describer and Transcriber must be a string only tag
TAG_DESCRIBER = XMP-dc:Description
TAG_TRANSCRIBER = XMP-dc:Title
CONTRIBUTOR_TAG = XMP-iptcExt:Contributor

[POLYGON]
REGION_NAME_PREFIX = graffito
REGION_ROLE_NAME = main subject area
RCTYPE_IDENTIFIER = https://vocabs.acdh.oeaw.ac.at/graphis-imgreg/graffiti
RCTYPE_NAME = graffito
REGION_CREATOR_ROLE = https://vocabs.acdh.oeaw.ac.at/graphis-imgreg/imgRegCreator
DESCRIBER_ROLE = https://vocabs.acdh.oeaw.ac.at/graphis-imgreg/descrWriter
TRANSCRIBER_ROLE = https://vocabs.acdh.oeaw.ac.at/graphis-imgreg/transcrWriter
COLOUR_START = #56B4E9

[RECTANGLE]
REGION_NAME_PREFIX = text (graffito)
